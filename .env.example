# Copy to .env and fill in. Never commit the real .env.
#
# In production set these in your host's environment (or in a .env file on
# the server). The app refuses to start if SECRET_KEY or ADMIN_PASSWORD are
# left at their defaults and FLASK_DEBUG isn't set.

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The password the whole team uses to get into /admin.
ADMIN_PASSWORD=change-me-too

# Where the SQLite file goes. A relative path is resolved against the project
# directory. On a host with a mounted disk, use an absolute path on that disk
# (e.g. /var/data/app.db) so it survives redeploys.
DATABASE_PATH=data/app.db

# Set to 1 once you're on https so the login cookie is https-only.
HTTPS_ONLY=0

# Local development only. Turns on the reloader and skips the startup check
# for default secrets. Never set this in production.
# FLASK_DEBUG=1
